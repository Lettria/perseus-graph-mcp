# Copy to .env and fill in PERSEUS_API_KEY:
#     cp sample.env .env
#
# All three scripts (start.py, index.py, server.py) load this file by absolute
# path, so it works regardless of the working directory a client launches from.

# --- Required ---------------------------------------------------------------

# Your Perseus API key — https://docs.perseus.lettria.net/
PERSEUS_API_KEY=

# --- Optional: Gemini (PDF conversion + NL2Cypher) --------------------------
# Used by index.py to convert PDFs to Markdown, and by server.py to enable
# NL2Cypher on every search (see README's "How retrieval works"). Leave blank
# to skip both. An exported GEMINI_API_KEY in your shell is used if set.

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview

# --- Graph database ---------------------------------------------------------
# Defaults match docker-compose.yml.

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=j4oenj4oen

# --- Vector database --------------------------------------------------------

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_CHUNKS_COLLECTION=chunks
QDRANT_COMMUNITIES_COLLECTION=communities
QDRANT_SCHEMA_COLLECTION=schema

# --- Embedder ---------------------------------------------------------------
# No path suffix: the retriever POSTs to this URL directly. VECTOR_SIZE must
# match the model in docker-compose.yml (bge-small-en-v1.5 is 384).

EMBEDDER_URL=http://localhost:8080
VECTOR_SIZE=384

# --- Logging ----------------------------------------------------------------

LOGLEVEL=INFO

# Leave FALKORDB_PASSWORD unset. simple-graph-retriever selects its backend by
# which password is set, not by any GRAPH_DATABASE_TYPE variable, so setting it
# would silently switch retrieval to FalkorDB.
